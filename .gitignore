# =====================================================================
# GITIGNORE - DISCORD DEADLINE & LOGISTICS GUARD (Trustmebro)
# =====================================================================

# Environment variables & API Keys (DO NOT COMMIT SECRETS)
.env
.env.*
!.env.example

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Temporary files & swap
*.tmp
tmp*
*.swp
*.swo
*~

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# IDE / Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Local runtime data — keep private, never commit
data/
logs/