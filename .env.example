# =====================================================================
# CẤU HÌNH MÔI TRƯỜNG - DISCORD DEADLINE & LOGISTICS GUARD
# Hướng dẫn: Copy file này thành file .env và điền giá trị tương ứng
# Lệnh copy: copy .env.example .env (Windows) hoặc cp .env.example .env (Linux/Mac)
# =====================================================================

# 1. Google Gemini API Key
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
# Lưu ý: Nếu để trống hoặc hết hạn mức (429 Quota Exceeded), hệ thống sẽ tự động 
# kích hoạt Hybrid Rule/Regex Fallback an toàn và cảnh báo trên giao diện web.
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# 2. Model Gemini sử dụng
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Server Configuration (Mặc định)
HOST=127.0.0.1
PORT=8000

# 4. Múi giờ hệ thống
TIMEZONE=Asia/Ho_Chi_Minh
